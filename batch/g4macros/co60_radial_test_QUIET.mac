/run/numberOfThreads 20

# Initialize kernel
/run/initialize
/control/macroPath ../G4Fridges/g4macros/

#
/control/verbose 2
/run/verbose 2
/run/printProgress 100000
/event/verbose 0
/tracking/verbose 0
# 
# gamma 6 MeV to the direction (0.,0.,1.)
#

# -92.6296mm is SQUAT chip
# 280.5mm is edge of fridge

/analysis/setFileName g4output/radial_study/r025mco60/QUIETOutput-r025mco60.csv
/quiet/source/type co60
/quiet/source/radius 342.6269 mm
/quiet/source/theta 270
/run/beamOn 500000000

/analysis/setFileName g4output/radial_study/r04mco60/QUIETOutput-r04mco60.csv
/quiet/source/type co60
/quiet/source/radius 492.6269 mm
/quiet/source/theta 270
/run/beamOn 500000000

/analysis/setFileName g4output/radial_study/r1mco60/QUIETOutput-r1mco60.csv
/quiet/source/type co60
/quiet/source/radius 1092.6269 mm
/quiet/source/theta 270
/run/beamOn 500000000