# SQUAT position: (79.9589, 0, 1439.95) mm
# OVCC: r = 280.5 mm

/run/numberOfThreads 60

# Initialize kernel
/run/initialize
/control/macroPath ../G4Fridges/g4macros/

#
/control/verbose 2
/run/verbose 2
/run/printProgress 100000
/event/verbose 0
/tracking/verbose 0
# 
# gamma 6 MeV to the direction (0.,0.,1.)
#

/random/setSeeds 84391 24678

/analysis/setFileName g4output/angular_study/theta270/OLAFOutput-theta270.csv
/olaf/source/theta 270
/run/beamOn 2000000000

/analysis/setFileName g4output/angular_study/theta285/OLAFOutput-theta285.csv
/olaf/source/theta 285
/run/beamOn 2000000000

/analysis/setFileName g4output/angular_study/theta300/OLAFOutput-theta300.csv
/olaf/source/theta 300
/run/beamOn 2000000000

/analysis/setFileName g4output/angular_study/theta315/OLAFOutput-theta315.csv
/olaf/source/theta 315
/run/beamOn 2000000000

/analysis/setFileName g4output/angular_study/theta330/OLAFOutput-theta330.csv
/olaf/source/theta 330
/run/beamOn 2000000000

/analysis/setFileName g4output/angular_study/theta345/OLAFOutput-theta345.csv
/olaf/source/theta 345
/run/beamOn 2000000000