# SQUAT position: (79.9589, 0, 1439.95) mm
# OVCC: r = 280.5 mm

/run/numberOfThreads 60

# Initialize kernel
/run/initialize
/control/macroPath ../G4Fridges/g4macros/

#
/control/verbose 2
/run/verbose 2
/run/printProgress 100000
/event/verbose 0
/tracking/verbose 0
# 
# gamma 6 MeV to the direction (0.,0.,1.)
#

/random/setSeeds 51799 96390

/analysis/setFileName g4output/angular_study/theta0/OLAFOutput-theta0.csv
/olaf/source/theta 0
/run/beamOn 2000000000

/analysis/setFileName g4output/angular_study/theta15/OLAFOutput-theta15.csv
/olaf/source/theta 15
/run/beamOn 2000000000

/analysis/setFileName g4output/angular_study/theta30/OLAFOutput-theta30.csv
/olaf/source/theta 30
/run/beamOn 2000000000

/analysis/setFileName g4output/angular_study/theta45/OLAFOutput-theta45.csv
/olaf/source/theta 45
/run/beamOn 2000000000

/analysis/setFileName g4output/angular_study/theta60/OLAFOutput-theta60.csv
/olaf/source/theta 60
/run/beamOn 2000000000

/analysis/setFileName g4output/angular_study/theta75/OLAFOutput-theta75.csv
/olaf/source/theta 75
/run/beamOn 2000000000
