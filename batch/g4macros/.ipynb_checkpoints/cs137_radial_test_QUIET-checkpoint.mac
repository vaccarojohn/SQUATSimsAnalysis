/run/numberOfThreads 20

# Initialize kernel
/run/initialize
/control/macroPath ../G4Fridges/g4macros/

#
/control/verbose 2
/run/verbose 2
/run/printProgress 100000
/event/verbose 0
/tracking/verbose 0
# 
# gamma 6 MeV to the direction (0.,0.,1.)
#

# -92.6296mm is SQUAT chip
# 280.5mm is edge of fridge

/analysis/setFileName g4output/radial_study/r025mcs137/QUIETOutput-r025mcs137.csv
/quiet/source/type cs137
/quiet/source/radius 342.6269 mm
/quiet/source/theta 270
/run/beamOn 500000000

/analysis/setFileName g4output/radial_study/r04mcs137/QUIETOutput-r04mcs137.csv
/quiet/source/type cs137
/quiet/source/radius 492.6269 mm
/quiet/source/theta 270
/run/beamOn 500000000

/analysis/setFileName g4output/radial_study/r1mcs137/QUIETOutput-r1mcs137.csv
/quiet/source/type cs137
/quiet/source/radius 1092.6269 mm
/quiet/source/theta 270
/run/beamOn 500000000